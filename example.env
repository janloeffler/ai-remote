# Copy to .env and fill in real values (never commit .env itself).
#
# API_KEY is the agent's bearer token AND the password you type into /login, and
# it is the only thing gating unattended command execution on the machine that
# runs the agent. SECRET_KEY signs the session cookie. Both must be at least 32
# characters or the backend refuses to start — generate them, don't invent them:
#   openssl rand -hex 32
API_KEY=
SECRET_KEY=
PORT=8000

# SQLite file location. docker-compose.yml hardcodes this to /data/app.db for
# the mounted volume, so this only matters if you run the backend directly
# (outside Docker).
DATABASE_PATH=app.db

# Your local machine's home directory, for `~`/`~/` expansion in the chat-list
# path filter. IMPORTANT: run.sh copies this file to .env verbatim on first
# run, so leaving the placeholder below unedited silently breaks `~` path
# filtering for anyone whose real home directory isn't literally
# /Users/yourname — set this to your own home directory.
LOCAL_HOME_DIR=/Users/yourname

# How many additional messages "Mehr laden" loads per click on a chat's
# detail page.
CHAT_HISTORY_PAGE_SIZE=10

# Login-throttle bucketing. By default the backend keys its 5-failures-per-300s
# login throttle on the immediate peer address and IGNORES X-Forwarded-For,
# because that header is client-supplied and rotating it would otherwise buy an
# attacker unlimited login attempts (SEC-001).
#
# Behind a reverse proxy every request arrives from the proxy, so with the
# default of 0 all login attempts — yours and an attacker's — share one bucket.
# To get per-client throttling back, set BOTH of these: how many trailing hops
# of X-Forwarded-For your own proxy appends (normally 1), and the peer
# address(es) that proxy presents to the container (comma-separated). Setting
# one without the other is refused at startup rather than silently ignored,
# because either half alone means throttling is weaker than it looks. Only
# configure them if the container port is NOT reachable except through that
# proxy — otherwise a client can connect directly and forge the header.
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXIES=

# Interactive API docs (/docs, /redoc, /openapi.json) are disabled by default
# because they were previously served unauthenticated (SEC-011), handing any
# visitor the full route map. Set to true locally if you want them back while
# developing.
ENABLE_API_DOCS=false

# Session cookie Secure flag. Default true is required for the real production
# deploy (Plesk terminates TLS, so the browser only ever sees https://).
# Set to false only for local http:// testing, e.g. run.sh sets this
# automatically — you normally don't need to touch this yourself.
SESSION_COOKIE_HTTPS_ONLY=true

# Default backend URL for the persistent background agent (setup-agent.sh
# reads this). run.sh's own local sync cycle ignores this — it always
# targets http://localhost:$PORT directly.
AI_REMOTE_BACKEND_URL=https://your-domain.example.com

# Used by build-and-push.sh / deploy-production-scp.sh (Task 16) — fill in
# before using those; not needed for local `run.sh` usage.
REGISTRY=
SSH_HOST=
SSH_PATH=/opt/ai-remote-backend

# SSH target for the Plesk-specific deploy path (deploy-to-plesk.sh only —
# not needed for local `run.sh` usage or the other deploy scripts).
PLESK_HOST=

# launchd service label (reverse-DNS style) used by setup-agent.sh when
# installing/uninstalling the background agent. Only needed if you want a
# label distinct from the default below.
AI_REMOTE_AGENT_LABEL=com.example.ai-remote-agent

# Comma-separated absolute paths where remote commands (resume/new-session)
# are allowed to run. Must be set to the SAME value in the local agent's own
# .env on the Mac — these are two independently-configured copies, neither
# editable via the API. Leave empty to disable remote command execution
# entirely (the composer/new-session UI simply won't offer any project).
# Entries must be written in their canonical (symlink-resolved) form — e.g.
# run `cd <dir> && pwd -P` to get the exact string to use — especially for
# paths under /tmp or other commonly-symlinked locations.
AI_REMOTE_ALLOWED_PROJECTS=

# The agent's own copy of the allow-list — must match the backend's
# AI_REMOTE_ALLOWED_PROJECTS above exactly. The agent has no dotenv loading
# of its own; if the backend and the agent run on different machines (e.g.
# the backend deployed via deploy-production-scp.sh to a remote server),
# set AI_REMOTE_ALLOWED_PROJECTS in the repo-root .env on the Mac that runs
# ./setup-agent.sh — it sources that .env and bakes the value into the
# generated launchd plist. Listed here only as a reminder that both copies
# must be kept in sync manually; see agent/README.md for the full flow.

# How often the local background agent checks the backend for pending jobs
# (sync, "Mehr laden" / "Gesamte Historie laden"), in seconds. Read by two
# places: the agent's own poll loop (agent/agent/config.py), and the backend
# (used to estimate the "Wird geladen... (ca. Xs)" countdown shown while a
# fetch job is in flight). Keep both in sync — they share this one value.
AI_REMOTE_INTERVAL_SECONDS=60

# How fast the agent polls while "active" — i.e. for ACTIVE_INTERVAL_DURATION_MIN minutes after
# any job-creating action (a command sent, "Mehr laden"/"Gesamte Historie laden", a new session
# started). Backend-only: unlike AI_REMOTE_INTERVAL_SECONDS, the agent never reads this itself —
# it just obeys whatever poll_interval_seconds the backend's /jobs/pending response tells it to
# use next.
AI_REMOTE_ACTIVE_INTERVAL_SECONDS=10

# How many minutes the faster active interval above stays in effect after the most recent
# job-creating action, before falling back to AI_REMOTE_INTERVAL_SECONDS. One global window
# across all chats, not per-chat.
ACTIVE_INTERVAL_DURATION_MIN=5
